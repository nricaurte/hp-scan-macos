--- a/io/hpmud/musb.c
+++ b/io/hpmud/musb.c
@@ -767,8 +767,23 @@
 
     if (rlen < 0)
     {
+#ifdef __APPLE__
+        /* macOS workaround: some HP printer firmwares (Smart Tank 500 etc.)
+         * do not implement IEEE 1284 GET_DEVICE_ID via USB control transfer
+         * and reject with STALL (LIBUSB_ERROR_PIPE). Synthesize a minimal
+         * device ID so the rest of hpmud accepts the device. The real model
+         * info is already known from the iProduct string descriptor read by
+         * musb_probe_devices(). */
+        const char *fake_id = "MFG:HP;CMD:LEDM;CLS:PRINTER;";
+        int fake_len = (int)strlen(fake_id);
+        if (fake_len >= size) fake_len = size - 1;
+        memcpy(buffer, fake_id, fake_len);
+        buffer[fake_len] = 0;
+        return fake_len;
+#else
         BUG("invalid deviceid ret=%d: %m\n", rlen);
         goto bugout;
+#endif
     }
 
     len = ntohs(*(short *)buffer);
@@ -906,9 +921,21 @@
 static int libusb_bulk_read(libusb_device_handle *dev, int ep, char *bytes, int size, int timeout)
 {
     int actual_len = 0;
-
+#ifdef __APPLE__
+    /* Preserve disconnect/errors instead of turning them into empty reads.
+     * libusb timeout=0 is infinite; keep a minimum finite wait. */
+    int result = libusb_bulk_transfer(dev, ep, (unsigned char*)bytes, size,
+                                      &actual_len, timeout > 0 ? timeout : 1);
+    if (result == LIBUSB_ERROR_TIMEOUT)
+        return actual_len > 0 ? actual_len : -ETIMEDOUT;
+    if (result != 0) {
+        errno = EIO;
+        return -EIO;
+    }
+#else
     libusb_bulk_transfer(dev, ep, (unsigned char*)bytes, size, &actual_len, timeout);
-    return actual_len ;
+#endif
+    return actual_len;
 }
 
 static int libusb_bulk_write(libusb_device_handle *dev, int ep, char *bytes, int size, int timeout)
@@ -2156,7 +2183,7 @@
     }//end for loop
 
 bugout:
-    if (!hd)
+    if (hd)            /* fix: previous code closed a NULL handle on success path */
         libusb_close(hd);
     if (confptr)
